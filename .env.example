# 复制为 .env 并填入你的 key。代码用 python-dotenv 自动加载。

# 必填：LLM API（OpenAI 兼容接口；默认 DashScope/Qwen）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 国内可改: https://dashscope.aliyuncs.com/compatible-mode/v1
# 切换到其它 provider 时改这两个值即可（OpenAI / DeepSeek / 智谱 / OpenRouter 等都支持 OpenAI 兼容接口）

# 可选：Reddit。不填则降级到匿名 JSON 端点（够用，但限速更严）
# https://www.reddit.com/prefs/apps → create app (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-inspiration-bot/1.0 by your_reddit_username

# 可选：YouTube Data API v3
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# 可选：X/Twitter API v2 Bearer Token
# https://developer.twitter.com/en/portal
TWITTER_BEARER_TOKEN=

# 可选：X/Twitter via 自建 RSSHub（推荐，免费）
# 从浏览器拿到登录态 X 账号的 auth_token cookie：
#   1. 登录 x.com → F12 打开 DevTools → Console
#   2. 粘贴：copy(document.cookie.split('; ').find(c=>c.startsWith('auth_token='))?.split('=')[1])
#   3. 把剪贴板里的 token 填到这里
# 建议用小号，避免主号被风控
TWITTER_AUTH_TOKEN=
